{
  "name": "@facturacionexpress/dgii-agent",
  "version": "1.0.0",
  "description": "Dominican DGII compliance & invoicing agent for automated tax compliance, NCF generation, and accounting workflows",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./invoicing": {
      "types": "./dist/invoicing.d.ts",
      "import": "./dist/invoicing.mjs",
      "require": "./dist/invoicing.js"
    },
    "./compliance": {
      "types": "./dist/compliance.d.ts",
      "import": "./dist/compliance.mjs",
      "require": "./dist/compliance.js"
    },
    "./dgii": {
      "types": "./dist/dgii.d.ts",
      "import": "./dist/dgii.mjs",
      "require": "./dist/dgii.js"
    }
  },
  "scripts": {
    "build": "tsc && npm run bundle",
    "bundle": "tsup src/index.ts src/invoicing.ts src/compliance.ts src/dgii.ts --format cjs,esm --dts --outDir dist",
    "dev": "tsc --watch",
    "test": "node --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "dgii",
    "invoice",
    "accounting",
    "compliance",
    "dominican-republic",
    "ncf",
    "tax",
    "rnc",
    "invoicing"
  ],
  "author": "Facturación Express RD",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/facturacionexpressrd-commits/dgii-agent.git"
  }
}
